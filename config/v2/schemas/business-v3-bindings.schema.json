{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/business/v3/bindings",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "tree_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "declaration_id": {
            "type": "string",
            "minLength": 1
          },
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "usage": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "enum": [
              "core",
              "supporting"
            ]
          },
          "route_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "declaration_id",
          "feature_id",
          "usage",
          "role",
          "route_id",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "declarations": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unprocessed",
              "researching",
              "assigned",
              "supporting",
              "excluded",
              "insufficient_evidence",
              "ambiguous",
              "failed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "status",
          "reason",
          "rule",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "unprocessed",
              "researching",
              "assigned",
              "supporting",
              "excluded",
              "insufficient_evidence",
              "ambiguous",
              "failed"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "rule": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "status",
          "reason",
          "rule",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "snapshot_id",
    "tree_ref",
    "bindings",
    "declarations",
    "topics"
  ],
  "additionalProperties": false
}
