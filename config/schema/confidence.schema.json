{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/confidence.schema.json",
  "$defs": {
    "text": {"type": "string", "pattern": "\\S"},
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "texts": {"type": "array", "items": {"$ref": "#/$defs/text"}, "minItems": 1},
    "case": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "platform", "context", "device_model", "os_build", "conditions", "steps", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/text"},
        "platform": {"$ref": "#/$defs/text"},
        "context": {"$ref": "comparison.schema.json#/$defs/context"},
        "device_model": {"$ref": "#/$defs/text"},
        "os_build": {"$ref": "#/$defs/text"},
        "conditions": {"$ref": "#/$defs/texts"},
        "steps": {"$ref": "#/$defs/texts"},
        "expected": {"$ref": "#/$defs/text"}
      }
    },
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["case_id", "plan_hash", "claim_hash", "outcome", "observed", "method", "tested_by", "tested_at", "artifact_path", "sha256"],
      "properties": {
        "case_id": {"$ref": "#/$defs/text"},
        "plan_hash": {"$ref": "#/$defs/hash"},
        "claim_hash": {"$ref": "#/$defs/hash"},
        "outcome": {"enum": ["pass", "fail", "inconclusive"]},
        "observed": {"$ref": "#/$defs/text"},
        "method": {"const": "human_physical_device"},
        "tested_by": {"$ref": "#/$defs/text"},
        "tested_at": {"type": "string", "format": "date-time"},
        "artifact_path": {"$ref": "#/$defs/text"},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "device_review": {
      "type": "object", "additionalProperties": false,
      "required": ["requirement", "reason"],
      "properties": {
        "requirement": {"enum": ["required", "recommended", "not_required"]},
        "reason": {"$ref": "#/$defs/text"},
        "cases": {"type": "array", "items": {"$ref": "#/$defs/case"}},
        "results": {"type": "array", "items": {"$ref": "#/$defs/result"}}
      },
      "allOf": [{
        "if": {"properties": {"requirement": {"enum": ["required", "recommended"]}}},
        "then": {"required": ["cases"], "properties": {"cases": {"minItems": 1}}},
        "else": {"properties": {"cases": {"maxItems": 0}, "results": {"maxItems": 0}}}
      }]
    }
  },
  "type": "object", "additionalProperties": false,
  "required": ["confidence", "rationale", "assessed_by", "assessed_at", "input_hash", "device_review"],
  "properties": {
    "confidence": {"enum": ["high", "medium", "low", "unassessed"]},
    "rationale": {"$ref": "#/$defs/text"},
    "assessed_by": {"$ref": "#/$defs/text"},
    "assessed_at": {"type": "string", "format": "date"},
    "input_hash": {"$ref": "#/$defs/hash"},
    "device_review": {"$ref": "#/$defs/device_review"}
  }
}
