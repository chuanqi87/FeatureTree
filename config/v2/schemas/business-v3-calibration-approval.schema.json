{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/business/v3/calibration-approval",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "tree_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sample_article_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "granularity_policy_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "confidence_policy_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "scope_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "decision": {
      "const": "approved"
    }
  },
  "required": [
    "schema_version",
    "id",
    "actor",
    "created_at",
    "tree_ref",
    "sample_article_refs",
    "granularity_policy_ref",
    "confidence_policy_ref",
    "scope_ids",
    "decision"
  ],
  "additionalProperties": false
}
