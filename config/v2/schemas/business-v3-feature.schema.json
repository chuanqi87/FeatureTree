{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/business/v3/feature",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "includes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "node_type": {
      "enum": [
        "branch",
        "leaf"
      ]
    },
    "comparison_dimensions": {
      "type": "array",
      "items": {
        "enum": [
          "capability_result",
          "programming_model",
          "lifecycle_background",
          "permissions_privacy",
          "limits_precision",
          "device_forms",
          "api_surface"
        ]
      }
    },
    "success_criteria": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "id",
    "parent_id",
    "name",
    "definition",
    "includes",
    "excludes",
    "node_type",
    "comparison_dimensions",
    "success_criteria"
  ],
  "additionalProperties": false
}
