{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/workflow/v2/fk-android",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "const": "fk-android"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "pass",
        "needs_sources",
        "revise",
        "completed_with_gaps"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "platform": {
          "const": "android"
        },
        "claims": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "claim_id": {
                "type": "string",
                "minLength": 1
              },
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "kind": {
                "enum": [
                  "support",
                  "fact",
                  "comparison"
                ]
              },
              "platforms": {
                "type": "array",
                "items": {
                  "enum": [
                    "android",
                    "ios",
                    "harmonyos"
                  ]
                }
              },
              "dimension": {
                "type": "string",
                "minLength": 1
              },
              "result": {
                "enum": [
                  "supported",
                  "conditional",
                  "unsupported",
                  "unknown",
                  "same",
                  "different",
                  "not_applicable",
                  "fact"
                ]
              },
              "statement": {
                "type": "string",
                "minLength": 1
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "premise_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "coverage_note": {
                "type": "string"
              },
              "alternative_paths": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "gaps": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "context": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "release": {
                      "type": "string",
                      "minLength": 1
                    },
                    "sdk": {
                      "type": "string",
                      "minLength": 1
                    },
                    "distribution": {
                      "type": "string",
                      "minLength": 1
                    },
                    "device_forms": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "conditions": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "applicability": {
                      "enum": [
                        "verified",
                        "unknown",
                        "unavailable"
                      ]
                    }
                  },
                  "required": [
                    "release",
                    "sdk",
                    "distribution",
                    "device_forms",
                    "conditions",
                    "applicability"
                  ],
                  "additionalProperties": false
                }
              }
            },
            "required": [
              "claim_id",
              "question_id",
              "kind",
              "platforms",
              "dimension",
              "result",
              "statement",
              "conditions",
              "evidence_refs",
              "premise_ids",
              "coverage_note",
              "alternative_paths",
              "gaps",
              "context"
            ],
            "additionalProperties": false
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "snapshot_id": {
                "type": "string",
                "minLength": 1
              },
              "document_id": {
                "type": "string",
                "minLength": 1
              },
              "url": {
                "type": "string",
                "format": "uri"
              },
              "body_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "excerpt": {
                "type": "string",
                "minLength": 1
              },
              "locator": {
                "type": "string",
                "minLength": 1
              },
              "platform": {
                "enum": [
                  "android",
                  "ios",
                  "harmonyos"
                ]
              },
              "applicability": {
                "enum": [
                  "verified",
                  "unknown",
                  "unavailable"
                ]
              },
              "source_revision": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "snapshot_id",
              "document_id",
              "url",
              "body_sha256",
              "excerpt",
              "locator",
              "platform",
              "applicability",
              "source_revision"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "platform",
        "claims",
        "evidence"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "fact",
              "alignment",
              "structure",
              "binding",
              "granularity",
              "coverage",
              "specification",
              "comparison",
              "confidence",
              "execution"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "gap",
              "advisory"
            ]
          },
          "target_stage": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "target_stage",
          "subject_ids",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "source_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "android",
              "ios",
              "harmonyos"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "platform",
          "query",
          "reason",
          "subject_ids",
          "source_urls"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "work_id",
    "task_id",
    "stage_id",
    "input_hash",
    "outcome",
    "payload",
    "issues",
    "source_requests"
  ],
  "additionalProperties": false
}
