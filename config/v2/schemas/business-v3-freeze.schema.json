{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/business/v3/freeze",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 3
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "root_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "leaf_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tree_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "snapshot_id": {
      "type": "string",
      "minLength": 1
    },
    "semantic_hashes": {
      "type": "object"
    },
    "binding_hashes": {
      "type": "object"
    },
    "approval_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "root_ids",
    "leaf_ids",
    "tree_ref",
    "bindings_ref",
    "baseline_ref",
    "snapshot_id",
    "semantic_hashes",
    "binding_hashes",
    "approval_ref",
    "review_refs",
    "created_at"
  ],
  "additionalProperties": false
}
