{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/feature.schema.json",
  "title": "FeatureComparisonUnit",
  "description": "A platform-neutral comparison subject. Platform assertions live in its knowledge record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "level",
    "parent",
    "name",
    "definition",
    "knowledge_role",
    "knowledge_path",
    "comparison_scope",
    "comparison_dimensions"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$",
      "description": "Stable identifier independent of current navigation; historical segments remain valid after a rename."
    },
    "level": {
      "type": "string",
      "pattern": "^L[1-9][0-9]*$",
      "description": "Depth label L1, L2, ... No hard cap."
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "description": "Parent feature id. Null only for L1 roots."
    },
    "name": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "zh",
        "en"
      ],
      "properties": {
        "zh": {
          "type": "string",
          "minLength": 1
        },
        "en": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "definition": {
      "type": "string",
      "minLength": 1,
      "description": "Platform-agnostic capability definition."
    },
    "aliases": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Official or brand names for discoverability (App Clips, Soft Bus, etc.)."
    },
    "knowledge_role": {
      "type": "string",
      "enum": [
        "leaf",
        "rollup"
      ],
      "description": "leaf and rollup both support platform comparisons; rollup records only its own scope."
    },
    "split_justification": {
      "type": [
        "string",
        "null"
      ],
      "description": "Why this node was split from parent. Required when level > L3 unless leaf_at_this_level is true."
    },
    "leaf_at_this_level": {
      "type": "boolean",
      "default": false,
      "description": "True when intentionally stopping deepen here (gate says stop)."
    },
    "layer": {
      "type": "string",
      "enum": [
        "os",
        "ecosystem",
        "mixed"
      ],
      "description": "Legacy navigation hint only; actual platform distribution and service dependencies belong to presence.context."
    },
    "device_forms": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "phone",
          "tablet",
          "watch",
          "tv",
          "auto",
          "iot",
          "desktop"
        ]
      },
      "uniqueItems": true,
      "description": "Intended navigation scope; not evidence of platform support."
    },
    "privacy_class": {
      "type": "string",
      "enum": [
        "none",
        "runtime_permission",
        "sensitive",
        "highly_sensitive"
      ],
      "default": "none",
      "description": "Navigation hint; platform permission conclusions belong to knowledge comparisons."
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "android": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "ios": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        },
        "harmonyos": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "knowledge_path": {
      "type": "string",
      "minLength": 1
    },
    "children": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Optional explicit child ids for navigation aids."
    },
    "notes": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "comparison_scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "includes",
        "excludes"
      ]
    },
    "comparison_dimensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "minItems": 1
    },
    "related_features": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "package",
            "class",
            "framework",
            "kit",
            "module",
            "syscap",
            "guide",
            "plist_key",
            "permission",
            "other"
          ]
        },
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "enum": [
            "primary",
            "related"
          ],
          "default": "primary"
        },
        "preferred": {
          "type": "boolean",
          "default": false,
          "description": "Preferred API generation on this platform (e.g. CameraX)."
        },
        "since": {
          "type": "string"
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "syscap": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
