{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/knowledge.schema.json",
  "title": "FeatureDifferenceKnowledge",
  "description": "Cross-platform difference knowledge article for a feature node.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "feature_id",
    "role",
    "status",
    "baseline",
    "definition",
    "presence",
    "comparisons",
    "evidence"
  ],
  "properties": {
    "feature_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)*$"
    },
    "role": {
      "type": "string",
      "enum": [
        "leaf",
        "rollup"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "stub",
        "draft",
        "reviewed"
      ]
    },
    "baseline": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      },
      "description": "Historical/planned baseline notes; confirmed support uses structured presence.context."
    },
    "definition": {
      "type": "string",
      "minLength": 1
    },
    "presence": {
      "type": "object",
      "additionalProperties": {
        "$ref": "https://featuretree.local/schema/comparison.schema.json#/$defs/support"
      }
    },
    "programming_model": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "lifecycle_background": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "permissions_privacy": {
      "type": "object",
      "properties": {
        "cross_ref": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "additionalProperties": {
        "type": "string"
      }
    },
    "limits_precision": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "device_forms": {
      "type": "string",
      "description": "Only when behavior diverges across forms."
    },
    "unique_extensions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "platform",
          "summary"
        ],
        "properties": {
          "platform": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string"
          },
          "feature_id": {
            "type": "string"
          }
        }
      }
    },
    "porting_traps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "trap"
        ],
        "properties": {
          "from": {
            "type": "string",
            "minLength": 1
          },
          "to": {
            "type": "string",
            "minLength": 1
          },
          "trap": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "https://featuretree.local/schema/comparison.schema.json#/$defs/evidence"
      }
    },
    "api_surface": {
      "type": "string",
      "description": "Naming/params/language surface diffs that must NOT become child nodes."
    },
    "child_index": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "For rollup articles: ordered child feature ids."
    },
    "architecture_diff": {
      "type": "string",
      "description": "For rollup: cross-child architectural differences only."
    },
    "schema_version": {
      "const": 2
    },
    "comparisons": {
      "type": "array",
      "items": {
        "$ref": "https://featuretree.local/schema/comparison.schema.json#/$defs/comparison"
      }
    },
    "legacy_presence": {
      "type": "object",
      "description": "Archived pre-v2 assertions. Never used to infer support or confirmed differences."
    },
    "legacy_definition": {
      "type": "string"
    },
    "migration_notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "facts": {
      "type": "array",
      "description": "Traceable platform facts; unstructured historical prose is not confirmed evidence.",
      "items": {
        "$ref": "https://featuretree.local/schema/comparison.schema.json#/$defs/fact"
      }
    }
  }
}
