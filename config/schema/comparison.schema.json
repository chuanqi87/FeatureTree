{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/comparison.schema.json",
  "$defs": {
    "context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release": {
          "type": "string",
          "minLength": 1
        },
        "sdk": {
          "type": "string",
          "minLength": 1
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        },
        "device_forms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 1
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        }
      },
      "required": [
        "release",
        "sdk",
        "distribution",
        "device_forms"
      ]
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "platform": {
          "type": "string",
          "minLength": 1
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "format": "uri"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "applies_to": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "sdk": {
              "type": "string",
              "minLength": 1
            },
            "distribution": {
              "type": "string",
              "minLength": 1
            },
            "device_forms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "release",
            "sdk",
            "distribution",
            "device_forms"
          ]
        },
        "fetched_at": {
          "type": "string",
          "format": "date-time"
        },
        "excerpt": {
          "type": "string",
          "pattern": "\\S",
          "description": "Exact relevant passage from the cached body; whitespace is normalized for validation."
        },
        "applicability_note": {
          "type": "string",
          "pattern": "\\S",
          "description": "Official basis for release, SDK, distribution and device applicability."
        },
        "source_kind": {
          "enum": [
            "api_reference",
            "developer_guide",
            "release_notes",
            "official_support"
          ]
        }
      },
      "required": [
        "id",
        "platform",
        "title",
        "url"
      ],
      "dependentRequired": {
        "local_path": [
          "sha256"
        ],
        "sha256": [
          "local_path"
        ]
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment": {"$ref": "confidence.schema.json"},
        "verification": {
          "enum": [
            "unreviewed",
            "in_review",
            "confirmed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "status": {
          "enum": [
            "unknown",
            "supported",
            "conditional",
            "unsupported"
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "release": {
              "type": "string",
              "minLength": 1
            },
            "sdk": {
              "type": "string",
              "minLength": 1
            },
            "distribution": {
              "type": "string",
              "minLength": 1
            },
            "device_forms": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true,
              "minItems": 1
            },
            "conditions": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "uniqueItems": true
            }
          },
          "required": [
            "release",
            "sdk",
            "distribution",
            "device_forms"
          ]
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "enum": [
            "official_statement",
            "evidence_based_analysis"
          ]
        },
        "coverage_note": {
          "type": "string",
          "pattern": "\\S"
        }
      },
      "required": [
        "status",
        "verification"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "rationale",
              "context",
              "evidence_refs",
              "verified_by",
              "verified_at",
              "subject_hash",
              "basis"
            ],
            "properties": {
              "status": {
                "not": {
                  "const": "unknown"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "conditional"
              },
              "verification": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "conditions"
            ],
            "properties": {
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment": {"$ref": "confidence.schema.json"},
        "verification": {
          "enum": [
            "unreviewed",
            "in_review",
            "confirmed"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verified_by": {
          "type": "string",
          "minLength": 1
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "dimension": {
          "type": "string",
          "minLength": 1
        },
        "platforms": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "minItems": 2,
          "maxItems": 2
        },
        "result": {
          "enum": [
            "unknown",
            "same",
            "different",
            "not_applicable"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "basis": {
          "enum": [
            "official_statement",
            "evidence_based_analysis"
          ]
        },
        "coverage_note": {
          "type": "string",
          "pattern": "\\S"
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "dimension",
        "platforms",
        "result",
        "verification"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "rationale",
              "scope",
              "evidence_refs",
              "verified_by",
              "verified_at",
              "subject_hash",
              "basis"
            ],
            "properties": {
              "result": {
                "not": {
                  "const": "unknown"
                }
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 2
              }
            }
          }
        }
      ]
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment": {"$ref": "confidence.schema.json"},
        "id": {
          "type": "string",
          "pattern": "\\S"
        },
        "platform": {
          "type": "string",
          "pattern": "\\S"
        },
        "dimension": {
          "type": "string",
          "pattern": "\\S"
        },
        "statement": {
          "type": "string",
          "pattern": "\\S"
        },
        "verification": {
          "enum": [
            "unreviewed",
            "in_review",
            "confirmed"
          ]
        },
        "basis": {
          "enum": [
            "official_statement",
            "evidence_based_analysis"
          ]
        },
        "rationale": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "verified_by": {
          "type": "string",
          "pattern": "\\S"
        },
        "verified_at": {
          "type": "string",
          "format": "date"
        },
        "subject_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "missing_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "\\S"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "platform",
        "dimension",
        "statement",
        "verification",
        "basis",
        "evidence_refs"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "verification": {
                "const": "confirmed"
              }
            }
          },
          "then": {
            "required": [
              "rationale",
              "verified_by",
              "verified_at",
              "subject_hash"
            ],
            "properties": {
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "uniqueItems": true,
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
