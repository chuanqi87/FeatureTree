{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/workflow/v2/ft-bind",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "const": "ft-bind"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "pass",
        "needs_sources",
        "revise",
        "completed_with_gaps"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "bindings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "declaration_id": {
                "type": "string",
                "minLength": 1
              },
              "feature_id": {
                "type": "string",
                "minLength": 1
              },
              "usage": {
                "type": "string",
                "minLength": 1
              },
              "role": {
                "enum": [
                  "core",
                  "supporting"
                ]
              },
              "route_id": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "declaration_id",
              "feature_id",
              "usage",
              "role",
              "route_id",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        },
        "api_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "unprocessed",
                  "researching",
                  "assigned",
                  "supporting",
                  "excluded",
                  "insufficient_evidence",
                  "ambiguous",
                  "failed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "status",
              "reason",
              "rule",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        },
        "topic_dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "enum": [
                  "unprocessed",
                  "researching",
                  "assigned",
                  "supporting",
                  "excluded",
                  "insufficient_evidence",
                  "ambiguous",
                  "failed"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              },
              "rule": {
                "type": "string",
                "minLength": 1
              },
              "evidence_refs": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "status",
              "reason",
              "rule",
              "evidence_refs"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "bindings",
        "api_dispositions",
        "topic_dispositions"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "fact",
              "alignment",
              "structure",
              "binding",
              "granularity",
              "coverage",
              "specification",
              "comparison",
              "confidence",
              "execution"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "gap",
              "advisory"
            ]
          },
          "target_stage": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "target_stage",
          "subject_ids",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "source_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "android",
              "ios",
              "harmonyos"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "platform",
          "query",
          "reason",
          "subject_ids",
          "source_urls"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "work_id",
    "task_id",
    "stage_id",
    "input_hash",
    "outcome",
    "payload",
    "issues",
    "source_requests"
  ],
  "additionalProperties": false
}
