{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/release/v1/manifest",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "release_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "tree_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "bindings_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "baseline_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "freeze_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "knowledge_refs": {
      "type": "object"
    },
    "review_projection_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "created_at": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "enum": [
        "publish",
        "rollback"
      ]
    },
    "rollback_target": {
      "type": [
        "string",
        "null"
      ]
    },
    "validation_ref": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schema_version",
    "release_id",
    "parent_id",
    "tree_ref",
    "bindings_ref",
    "baseline_ref",
    "source_ids",
    "freeze_refs",
    "knowledge_refs",
    "review_projection_ref",
    "created_at",
    "kind",
    "rollback_target",
    "validation_ref"
  ],
  "additionalProperties": false
}
