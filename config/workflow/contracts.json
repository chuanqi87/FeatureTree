{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "axis",
        "groups",
        "boundaries",
        "questions"
      ],
      "properties": {
        "axis": {
          "type": "string",
          "minLength": 1
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "definition"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "boundaries": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "questions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidates",
        "queries",
        "gaps"
      ],
      "properties": {
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "name",
              "definition",
              "binding",
              "distribution",
              "device_forms",
              "conditions",
              "public_api",
              "rationale"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "binding": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "id",
                  "url"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "package",
                      "class",
                      "framework",
                      "kit",
                      "module",
                      "syscap",
                      "guide",
                      "plist_key",
                      "permission",
                      "other"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "url": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "distribution": {
                "type": "string",
                "minLength": 1
              },
              "device_forms": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "conditions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "public_api": {
                "enum": [
                  "yes",
                  "unknown"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "queries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "synthesize": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nodes",
        "dispositions",
        "decisions",
        "gaps"
      ],
      "properties": {
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "dispositions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "candidate_id",
              "decision",
              "node_ids",
              "reason"
            ],
            "properties": {
              "candidate_id": {
                "type": "string",
                "minLength": 1
              },
              "decision": {
                "enum": [
                  "adopted",
                  "duplicate",
                  "out_of_scope",
                  "deferred"
                ]
              },
              "node_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "decisions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "action",
              "reason"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "action": {
                "enum": [
                  "stop",
                  "expand"
                ]
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reviewed_hash",
        "verdict",
        "checks",
        "issues"
      ],
      "properties": {
        "reviewed_hash": {
          "type": "string",
          "minLength": 1
        },
        "verdict": {
          "enum": [
            "pass",
            "revise"
          ]
        },
        "checks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "coverage",
            "axis",
            "boundaries",
            "granularity",
            "naming",
            "anchors",
            "dispositions"
          ],
          "properties": {
            "coverage": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "axis": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "boundaries": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "granularity": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "naming": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "anchors": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "dispositions": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "status",
                "reason"
              ],
              "properties": {
                "status": {
                  "enum": [
                    "pass",
                    "issue"
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "node_id",
              "code",
              "severity",
              "message",
              "requested_change"
            ],
            "properties": {
              "node_id": {
                "type": "string",
                "minLength": 1
              },
              "code": {
                "type": "string",
                "minLength": 1
              },
              "severity": {
                "enum": [
                  "blocking",
                  "warning"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              },
              "requested_change": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  },
  "envelope": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "schema_version",
      "task_id",
      "input_hash",
      "stage",
      "payload"
    ],
    "properties": {
      "schema_version": {
        "const": 1
      },
      "task_id": {
        "type": "string",
        "minLength": 1
      },
      "input_hash": {
        "type": "string",
        "minLength": 1
      },
      "stage": {
        "enum": [
          "scope",
          "android",
          "ios",
          "harmonyos",
          "synthesize",
          "review",
          "integrate"
        ]
      },
      "payload": {}
    }
  }
}
