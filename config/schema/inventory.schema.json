{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/inventory.schema.json",
  "title": "PlatformInventoryEntry",
  "description": "One harvested catalog unit from a platform SDK or ecosystem.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "native_id",
    "platform",
    "title",
    "kind",
    "visibility",
    "version",
    "schema_version",
    "scope",
    "scope_method",
    "scope_reason",
    "source",
    "mappings"
  ],
  "properties": {
    "native_id": {
      "type": "string",
      "minLength": 1,
      "description": "Platform-native identifier (package, framework, kit, module, etc.)."
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "parent": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "package",
        "class",
        "guide",
        "framework",
        "kit",
        "module",
        "syscap",
        "gms",
        "hms",
        "other"
      ]
    },
    "layer": {
      "enum": [
        "os",
        "ecosystem",
        "unknown"
      ]
    },
    "version": {
      "type": "string"
    },
    "visibility": {
      "type": "string",
      "enum": [
        "public",
        "hidden",
        "deprecated",
        "duplicate",
        "system"
      ],
      "description": "Coverage audit counts only visibility=public."
    },
    "notes": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "scope": {
      "enum": [
        "included",
        "excluded",
        "pending"
      ]
    },
    "scope_method": {
      "enum": [
        "rule",
        "manual"
      ]
    },
    "scope_reason": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "local_path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "distribution": {
          "type": "string",
          "minLength": 1
        },
        "version_pinned": {
          "type": "boolean"
        }
      },
      "required": [
        "local_path",
        "sha256",
        "distribution",
        "version_pinned"
      ]
    },
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "feature_id": {
            "type": "string",
            "minLength": 1
          },
          "relationship": {
            "enum": [
              "catalog",
              "capability"
            ]
          },
          "verification": {
            "enum": [
              "candidate",
              "confirmed"
            ]
          },
          "method": {
            "enum": [
              "rule",
              "manual"
            ]
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "evidence_url": {
            "type": "string",
            "format": "uri"
          },
          "verified_by": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "format": "date"
          }
        },
        "required": [
          "feature_id",
          "relationship",
          "verification",
          "method",
          "rationale"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "verification": {
                  "const": "confirmed"
                }
              }
            },
            "then": {
              "required": [
                "evidence_url",
                "verified_by",
                "verified_at"
              ],
              "properties": {
                "method": {
                  "const": "manual"
                }
              }
            }
          }
        ]
      }
    }
  }
}
