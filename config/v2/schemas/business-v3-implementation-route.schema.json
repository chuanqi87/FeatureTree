{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/business/v3/implementation-route",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "feature_id": {
      "type": "string",
      "minLength": 1
    },
    "platform": {
      "enum": [
        "android",
        "ios",
        "harmonyos"
      ]
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "conditions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "api_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          }
        },
        "required": [
          "description",
          "api_ids"
        ],
        "additionalProperties": false
      }
    },
    "completeness": {
      "enum": [
        "complete",
        "partial"
      ]
    },
    "gaps": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    }
  },
  "required": [
    "id",
    "feature_id",
    "platform",
    "goal",
    "conditions",
    "steps",
    "completeness",
    "gaps",
    "evidence_refs"
  ],
  "additionalProperties": false
}
