{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://featuretree.local/schema/workflow/v2/ft-design",
  "type": "object",
  "properties": {
    "protocol_version": {
      "const": 2
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "work_id": {
      "type": "string",
      "minLength": 1
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "stage_id": {
      "const": "ft-design"
    },
    "input_hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "outcome": {
      "enum": [
        "pass",
        "needs_sources",
        "revise",
        "completed_with_gaps"
      ]
    },
    "payload": {
      "type": "object",
      "properties": {
        "work_type": {
          "enum": [
            "skeleton",
            "refine",
            "revise"
          ]
        },
        "features": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "parent_id": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "name": {
                "type": "string",
                "minLength": 1
              },
              "definition": {
                "type": "string",
                "minLength": 1
              },
              "includes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "excludes": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "node_type": {
                "enum": [
                  "branch",
                  "leaf"
                ]
              },
              "comparison_dimensions": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "success_criteria": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "id",
              "parent_id",
              "name",
              "definition",
              "includes",
              "excludes",
              "node_type",
              "comparison_dimensions",
              "success_criteria"
            ],
            "additionalProperties": false
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "operation": {
                "enum": [
                  "add",
                  "rename",
                  "move",
                  "split",
                  "merge",
                  "redefine"
                ]
              },
              "subject_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "candidate_ids": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "operation",
              "subject_ids",
              "candidate_ids",
              "reason"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "work_type",
        "features",
        "changes"
      ],
      "additionalProperties": false
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "source",
              "fact",
              "alignment",
              "structure",
              "binding",
              "granularity",
              "coverage",
              "specification",
              "comparison",
              "confidence",
              "execution"
            ]
          },
          "severity": {
            "enum": [
              "blocking",
              "gap",
              "advisory"
            ]
          },
          "target_stage": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "id",
          "kind",
          "severity",
          "target_stage",
          "subject_ids",
          "reason",
          "evidence_refs"
        ],
        "additionalProperties": false
      }
    },
    "source_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "platform": {
            "enum": [
              "android",
              "ios",
              "harmonyos"
            ]
          },
          "query": {
            "type": "string",
            "minLength": 1
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "subject_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "source_urls": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "required": [
          "platform",
          "query",
          "reason",
          "subject_ids",
          "source_urls"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "work_id",
    "task_id",
    "stage_id",
    "input_hash",
    "outcome",
    "payload",
    "issues",
    "source_requests"
  ],
  "additionalProperties": false
}
